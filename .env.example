# Copy to .env, fill every required value, then chmod 600 .env. Use hex values
# for passwords so they are safe to embed in the internal PostgreSQL URL.
APP_DOMAIN=
DB_ADMIN_PASSWORD=
DB_PASSWORD=
JWT_SECRET=

# Used only for the first explicit `docker compose --profile setup run --rm db-setup`.
# Remove these three values from .env after creating the initial administrator.
BML_BOOTSTRAP_ADMIN_USERNAME=
BML_BOOTSTRAP_ADMIN_NAME=
BML_BOOTSTRAP_ADMIN_PASSWORD=

# Email verification and password reset codes (SMTP). The sender must be
# authorized by your email provider. Use port 465 with SMTP_SECURE=true or
# port 587 with SMTP_SECURE=false.
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASSWORD=
EMAIL_FROM=

# Snippe handles customer repayments and approved-loan payouts. Leave all four
# values empty to keep provider payments disabled until merchant credentials exist.
SNIPPE_BASE_URL=
SNIPPE_API_KEY=
SNIPPE_WEBHOOK_SECRET=
SNIPPE_WEBHOOK_URL=

# Keep empty to disable SMS until Beem credentials and sender ID are ready.
BEEM_SMS_API_KEY=
BEEM_SMS_API_SECRET=
BEEM_SMS_SENDER_ID=
